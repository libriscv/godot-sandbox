# A small register machine of the "logic CPU" shape: a fetch-decode-execute loop
# whose execute step is one switch on the opcode. It exists to keep the compiler
# honest about dispatch -- the match below is the hot code.
#
# An instruction is one integer word:
#
#     bits 0-7    opcode
#     bits 8-15   destination register (0-5)
#     bits 16-23  source register (0-5)
#     bits 24-31  immediate, or a jump target

const OP_HALT  = 0
const OP_LOADI = 1
const OP_MOV   = 2
const OP_ADD   = 3
const OP_SUB   = 4
const OP_MUL   = 5
const OP_AND   = 6
const OP_OR    = 7
const OP_XOR   = 8
const OP_SHL   = 9
const OP_SHR   = 10
const OP_LT    = 11
const OP_JMP   = 12
const OP_JZ    = 13
const OP_JNZ   = 14
const OP_OUT   = 15

func encode(op : int, dst : int, src : int, imm : int) -> int:
	return op | (dst << 8) | (src << 16) | (imm << 24)

# Run `program` until it halts or `fuel` runs out. Returns everything OP_OUT
# produced, i.e. the whole trace rather than the last value.
func run(program : Array, fuel : int) -> Array:
	var reg : Array = [0, 0, 0, 0, 0, 0]
	var out : Array = []
	var pc : int = 0
	while fuel > 0:
		fuel -= 1
		var word : int = program[pc]
		pc += 1
		var op : int = word & 255
		var dst : int = (word >> 8) & 255
		var src : int = (word >> 16) & 255
		var imm : int = (word >> 24) & 255
		match op:
			OP_HALT:
				return out
			OP_LOADI:
				reg[dst] = imm
			OP_MOV:
				reg[dst] = reg[src]
			OP_ADD:
				reg[dst] = reg[dst] + reg[src]
			OP_SUB:
				reg[dst] = reg[dst] - reg[src]
			OP_MUL:
				reg[dst] = reg[dst] * reg[src]
			OP_AND:
				reg[dst] = reg[dst] & reg[src]
			OP_OR:
				reg[dst] = reg[dst] | reg[src]
			OP_XOR:
				reg[dst] = reg[dst] ^ reg[src]
			OP_SHL:
				reg[dst] = reg[dst] << imm
			OP_SHR:
				reg[dst] = reg[dst] >> imm
			OP_LT:
				if reg[dst] < reg[src]:
					reg[dst] = 1
				else:
					reg[dst] = 0
			OP_JMP:
				pc = imm
			OP_JZ:
				if reg[dst] == 0:
					pc = imm
			OP_JNZ:
				if reg[dst] != 0:
					pc = imm
			OP_OUT:
				out.append(reg[dst])
			_:
				# An unknown opcode halts the machine, rather than idling
				# until the fuel runs out.
				return out
	return out

# 1 + 2 + ... + n, computed by the machine above. Returns [sum].
func sum_to(n : int) -> Array:
	var program : Array = []
	program.append(encode(OP_LOADI, 0, 0, 0))     #  0: acc   = 0
	program.append(encode(OP_LOADI, 1, 0, 1))     #  1: i     = 1
	program.append(encode(OP_LOADI, 2, 0, n + 1)) #  2: limit = n + 1
	program.append(encode(OP_LOADI, 3, 0, 1))     #  3: step  = 1
	program.append(encode(OP_MOV,   4, 1, 0))     #  4: t     = i
	program.append(encode(OP_LT,    4, 2, 0))     #  5: t     = t < limit
	program.append(encode(OP_JZ,    4, 0, 10))    #  6: if !t goto 10
	program.append(encode(OP_ADD,   0, 1, 0))     #  7: acc  += i
	program.append(encode(OP_ADD,   1, 3, 0))     #  8: i    += step
	program.append(encode(OP_JMP,   0, 0, 4))     #  9: goto 4
	program.append(encode(OP_OUT,   0, 0, 0))     # 10: emit acc
	program.append(encode(OP_HALT,  0, 0, 0))     # 11: stop
	return run(program, 4096)

# Exercises the arms the summing program never reaches. Emits, in order:
# a-b, a*b, a&b, a|b, a^b, a<<1, a>>2, then a JNZ countdown 3, 2, 1.
func alu_trace(a : int, b : int) -> Array:
	var program : Array = []
	program.append(encode(OP_LOADI, 0, 0, a))  #  0: r0 = a
	program.append(encode(OP_LOADI, 1, 0, b))  #  1: r1 = b
	program.append(encode(OP_MOV,   2, 0, 0))  #  2: r2 = r0
	program.append(encode(OP_SUB,   2, 1, 0))  #  3: r2 -= r1
	program.append(encode(OP_OUT,   2, 0, 0))  #  4: emit a - b
	program.append(encode(OP_MOV,   2, 0, 0))  #  5: r2 = r0
	program.append(encode(OP_MUL,   2, 1, 0))  #  6: r2 *= r1
	program.append(encode(OP_OUT,   2, 0, 0))  #  7: emit a * b
	program.append(encode(OP_MOV,   2, 0, 0))  #  8: r2 = r0
	program.append(encode(OP_AND,   2, 1, 0))  #  9: r2 &= r1
	program.append(encode(OP_OUT,   2, 0, 0))  # 10: emit a & b
	program.append(encode(OP_MOV,   2, 0, 0))  # 11: r2 = r0
	program.append(encode(OP_OR,    2, 1, 0))  # 12: r2 |= r1
	program.append(encode(OP_OUT,   2, 0, 0))  # 13: emit a | b
	program.append(encode(OP_MOV,   2, 0, 0))  # 14: r2 = r0
	program.append(encode(OP_XOR,   2, 1, 0))  # 15: r2 ^= r1
	program.append(encode(OP_OUT,   2, 0, 0))  # 16: emit a ^ b
	program.append(encode(OP_MOV,   2, 0, 0))  # 17: r2 = r0
	program.append(encode(OP_SHL,   2, 0, 1))  # 18: r2 <<= 1
	program.append(encode(OP_OUT,   2, 0, 0))  # 19: emit a << 1
	program.append(encode(OP_MOV,   2, 0, 0))  # 20: r2 = r0
	program.append(encode(OP_SHR,   2, 0, 2))  # 21: r2 >>= 2
	program.append(encode(OP_OUT,   2, 0, 0))  # 22: emit a >> 2
	program.append(encode(OP_LOADI, 3, 0, 3))  # 23: r3 = 3
	program.append(encode(OP_LOADI, 4, 0, 1))  # 24: r4 = 1
	program.append(encode(OP_OUT,   3, 0, 0))  # 25: emit r3
	program.append(encode(OP_SUB,   3, 4, 0))  # 26: r3 -= r4
	program.append(encode(OP_JNZ,   3, 0, 25)) # 27: if r3 goto 25
	program.append(encode(OP_HALT,  0, 0, 0))  # 28: stop
	return run(program, 4096)

# An unknown opcode stops the machine where it is.
func unknown_opcode() -> Array:
	var program : Array = []
	program.append(encode(OP_LOADI, 0, 0, 7))
	program.append(encode(OP_OUT,   0, 0, 0))
	program.append(encode(99,       0, 0, 0))
	program.append(encode(OP_OUT,   0, 0, 0))
	return run(program, 64)

# Running out of fuel returns what the machine emitted so far.
func out_of_fuel() -> Array:
	var program : Array = []
	program.append(encode(OP_LOADI, 0, 0, 1))
	program.append(encode(OP_OUT,   0, 0, 0))
	program.append(encode(OP_JMP,   0, 0, 1))
	return run(program, 7)
