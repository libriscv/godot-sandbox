# A register machine, as a mod.
#
# Compiled to RISC-V at load time, runs in a sandbox with all host access
# denied. Reaches the game only through the Dictionary from mod_init().
#
# Instruction encoding (one 32-bit word):
#   bits  0-7   opcode
#   bits  8-15  destination register (0-7)
#   bits 16-23  source register (0-7)
#   bits 24-31  immediate / jump target

const OP_NOP   = 0
const OP_LOADI = 1
const OP_MOV   = 2
const OP_JMP   = 3
const OP_JZ    = 4
const OP_JNZ   = 5

const OP_ADD   = 6
const OP_SUB   = 7
const OP_MUL   = 8
const OP_DIV   = 9
const OP_MOD   = 10
const OP_AND   = 11
const OP_OR    = 12
const OP_XOR   = 13
const OP_SHL   = 14
const OP_SHR   = 15
const OP_LT    = 16
const OP_EQ    = 17
const OP_NEG   = 18
const OP_NOT   = 19

const REGISTERS = 8

var reg : Array = [0, 0, 0, 0, 0, 0, 0, 0]
var program : Array = []
var pc : int = 0
var cycles : int = 0
var frames : int = 0

# A Dictionary containing the API that we are allowed to use.
var api : Dictionary = {}
var cycles_per_frame : int = 1000

func encode(op : int, dst : int, src : int, imm : int) -> int:
	return op | (dst << 8) | (src << 16) | (imm << 24)

func alu(op : int, a : int, b : int) -> int:
	match op:
		OP_ADD:
			return a + b
		OP_SUB:
			return a - b
		OP_MUL:
			return a * b
		OP_DIV:
			if b == 0:
				return 0
			return a / b
		OP_MOD:
			if b == 0:
				return 0
			return a % b
		OP_AND:
			return a & b
		OP_OR:
			return a | b
		OP_XOR:
			return a ^ b
		OP_SHL:
			return a << (b & 31)
		OP_SHR:
			return a >> (b & 31)
		OP_LT:
			if a < b:
				return 1
			return 0
		OP_EQ:
			if a == b:
				return 1
			return 0
		OP_NEG:
			return -a
		OP_NOT:
			return ~a
	return a

func step() -> void:
	var word : int = program[pc]
	pc += 1
	if pc >= program.size():
		pc = 0
	var op : int = word & 255
	var dst : int = (word >> 8) & 255
	var src : int = (word >> 16) & 255
	var imm : int = (word >> 24) & 255
	match op:
		OP_NOP:
			pass
		OP_LOADI:
			reg[dst] = imm
		OP_MOV:
			reg[dst] = reg[src]
		OP_JMP:
			pc = imm
		OP_JZ:
			if reg[dst] == 0:
				pc = imm
		OP_JNZ:
			if reg[dst] != 0:
				pc = imm
		_:
			reg[dst] = alu(op, reg[dst], reg[src])

func run(n : int) -> void:
	var i : int = 0
	while i < n:
		step()
		i += 1
	cycles += n

func build_program() -> Array:
	var p : Array = []
	p.append(encode(OP_LOADI, 1, 0, 1))    #  0: r1 = 1
	p.append(encode(OP_LOADI, 3, 0, 7))    #  1: r3 = 7
	p.append(encode(OP_ADD,   0, 1, 0))    #  2: r0 += r1
	p.append(encode(OP_MOV,   2, 0, 0))    #  3: r2 = r0
	p.append(encode(OP_LOADI, 4, 0, 3))    #  4: r4 = 3
	p.append(encode(OP_MUL,   2, 4, 0))    #  5: r2 *= r4
	p.append(encode(OP_LOADI, 5, 0, 5))    #  6: r5 = 5
	p.append(encode(OP_ADD,   2, 5, 0))    #  7: r2 += r5
	p.append(encode(OP_SUB,   2, 1, 0))    #  8: r2 -= r1
	p.append(encode(OP_LOADI, 6, 0, 2))    #  9: r6 = 2
	p.append(encode(OP_SHL,   2, 6, 0))    # 10: r2 <<= 2
	p.append(encode(OP_SHR,   2, 1, 0))    # 11: r2 >>= 1
	p.append(encode(OP_LOADI, 6, 0, 10))   # 12: r6 = 10
	p.append(encode(OP_DIV,   2, 6, 0))    # 13: r2 /= 10
	p.append(encode(OP_LOADI, 6, 0, 251))  # 14: r6 = 251
	p.append(encode(OP_MOD,   2, 6, 0))    # 15: r2 %= 251
	p.append(encode(OP_LOADI, 6, 0, 170))  # 16: r6 = 0xAA
	p.append(encode(OP_XOR,   2, 6, 0))    # 17: r2 ^= 0xAA
	p.append(encode(OP_OR,    2, 1, 0))    # 18: r2 |= r1
	p.append(encode(OP_AND,   2, 6, 0))    # 19: r2 &= 0xAA
	p.append(encode(OP_ADD,   7, 2, 0))    # 20: r7 += r2
	p.append(encode(OP_MOV,   4, 7, 0))    # 21: r4 = r7
	p.append(encode(OP_NEG,   4, 0, 0))    # 22: r4 = -r4
	p.append(encode(OP_NOT,   4, 0, 0))    # 23: r4 = ~r4
	p.append(encode(OP_LT,    4, 7, 0))    # 24: r4 = r4 < r7
	p.append(encode(OP_EQ,    5, 1, 0))    # 25: r5 = r5 == r1
	p.append(encode(OP_SUB,   3, 1, 0))    # 26: r3 -= 1
	p.append(encode(OP_JNZ,   3, 0, 2))    # 27: if r3 goto 2
	p.append(encode(OP_LOADI, 6, 0, 255))  # 28: r6 = 255
	p.append(encode(OP_AND,   7, 6, 0))    # 29: r7 &= 255
	p.append(encode(OP_NOP,   0, 0, 0))    # 30: nop
	p.append(encode(OP_JMP,   0, 0, 0))    # 31: goto 0
	return p

func mod_init(granted : Dictionary) -> void:
	api = granted
	cycles_per_frame = api["cycles_per_frame"]
	program = build_program()
	api["log"].call("register machine ready, " + str(program.size()) + " words")

func _physics_process(_delta):
	if program.size() == 0:
		return
	frames += 1
	run(cycles_per_frame)
	api["report"].call("cycles", cycles)
	api["report"].call("pc", pc)
	api["report"].call("acc", reg[7])
	if frames % 120 == 0:
		api["log"].call("frame " + str(frames) + " cycles " + str(cycles) + " pc " + str(pc) + " r7 " + str(reg[7]))

func get_registers() -> Array:
	return reg

func get_cycles() -> int:
	return cycles
