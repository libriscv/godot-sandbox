// @GlobalScope constants. Compile-time immediates, no syscall.
// Transcribed from godot-cpp global_constants.hpp (extension_api.json).
// Type tags use Variant:: to track variant_types.h.
// Requires GDSC_INT_CONSTANT / GDSC_FLOAT_CONSTANT defined before inclusion.

#ifndef GDSC_INT_CONSTANT
#define GDSC_INT_CONSTANT(name, value)
#endif
#ifndef GDSC_FLOAT_CONSTANT
#define GDSC_FLOAT_CONSTANT(name, value)
#endif

// Math. PI/TAU from math_defs.h; INF/NAN from Godot, not C macros.
GDSC_FLOAT_CONSTANT(PI, 3.1415926535897932384626433833)
GDSC_FLOAT_CONSTANT(TAU, 6.2831853071795864769252867666)
GDSC_FLOAT_CONSTANT(INF, std::numeric_limits<double>::infinity())
GDSC_FLOAT_CONSTANT(NAN, std::numeric_limits<double>::quiet_NaN())

