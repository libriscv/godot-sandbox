// Built-in type constants (Vector2.ZERO, Color.RED, Plane.PLANE_XY).
// From extension_api.json; folded into MAKE_* at use. Four components per row;
// constructor arity determines how many are read.
// Requires GDSC_BUILTIN_CONSTANT defined before inclusion.

#ifndef GDSC_BUILTIN_CONSTANT
#define GDSC_BUILTIN_CONSTANT(type, name, c0, c1, c2, c3)
#endif


// Vector2
GDSC_BUILTIN_CONSTANT(Vector2, ZERO, 0, 0, 0, 0)
GDSC_BUILTIN_CONSTANT(Vector2, ONE, 1, 1, 0, 0)
GDSC_BUILTIN_CONSTANT(Vector2, INF, std::numeric_limits<double>::infinity(), std::numeric_limits<double>::infinity(), 0, 0)
GDSC_BUILTIN_CONSTANT(Vector2, LEFT, -1, 0, 0, 0)
GDSC_BUILTIN_CONSTANT(Vector2, RIGHT, 1, 0, 0, 0)
GDSC_BUILTIN_CONSTANT(Vector2, UP, 0, -1, 0, 0)
GDSC_BUILTIN_CONSTANT(Vector2, DOWN, 0, 1, 0, 0)

// Vector2i
GDSC_BUILTIN_CONSTANT(Vector2i, ZERO, 0, 0, 0, 0)
GDSC_BUILTIN_CONSTANT(Vector2i, ONE, 1, 1, 0, 0)
GDSC_BUILTIN_CONSTANT(Vector2i, MIN, -2147483648, -2147483648, 0, 0)
GDSC_BUILTIN_CONSTANT(Vector2i, MAX, 2147483647, 2147483647, 0, 0)
GDSC_BUILTIN_CONSTANT(Vector2i, LEFT, -1, 0, 0, 0)
GDSC_BUILTIN_CONSTANT(Vector2i, RIGHT, 1, 0, 0, 0)
GDSC_BUILTIN_CONSTANT(Vector2i, UP, 0, -1, 0, 0)
GDSC_BUILTIN_CONSTANT(Vector2i, DOWN, 0, 1, 0, 0)

// Vector3
