GDSC_BUILTIN_CONSTANT(Vector3, LEFT, -1, 0, 0, 0)
GDSC_BUILTIN_CONSTANT(Vector3, RIGHT, 1, 0, 0, 0)
GDSC_BUILTIN_CONSTANT(Vector3, UP, 0, 1, 0, 0)
GDSC_BUILTIN_CONSTANT(Vector3, DOWN, 0, -1, 0, 0)
