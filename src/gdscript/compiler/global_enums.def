// @GlobalScope enumerations (Side, Corner, Error, Key, ...). Transcribed from
// godot-cpp's global_constants.hpp (extension_api.json), Godot 4.6.
//
// Every member is also a bare @GlobalScope constant in global_constants.def --
// GDScript reaches SIDE_LEFT both ways -- except the two nested under Variant,
// which have no unqualified spelling. test_globals pins the two files together.
//
// The enum name is a string because Variant.Type and Variant.Operator are
// spelled with a dot; the rest are ordinary identifiers.
//
// Requires GDSC_GLOBAL_ENUM_VALUE defined before inclusion.

#ifndef GDSC_GLOBAL_ENUM_VALUE
#define GDSC_GLOBAL_ENUM_VALUE(enum_name, name, value)
#endif


